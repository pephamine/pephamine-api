{
  "name": "pephamine-api",
  "version": "0.1.0",
  "description": "Pephamine backend API - Express.js with TypeScript, Drizzle ORM, PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate:pg",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "typescript",
    "drizzle",
    "postgresql",
    "api"
  ],
  "author": "Pephamine",
  "license": "MIT",
  "dependencies": {
    "@workspace/api-zod": "*",
    "express": "^4.19.2",
    "pg": "^8.11.3",
    "drizzle-orm": "^0.31.4",
    "jsonwebtoken": "^9.1.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cookie-parser": "^1.4.7",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "drizzle-kit": "^0.21.4",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0"
  }
}
